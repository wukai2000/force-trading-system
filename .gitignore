# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.ipynb_checkpoints/

# Env & secrets
.env
.env.*
!.env.example

# Data caches & large downloads (keep structure via .gitkeep)
data/cache/
data/prices/*
data/macro/*
data/cot/*
data/flows/*
data/naming/*
data/state/*
!data/**/.gitkeep
!data/meta/
!data/meta/last_fetch.json

# Logs & runtime artifacts
logs/*.log
logs/*
!logs/.gitkeep
artifacts/*.png
artifacts/charts/*
!artifacts/.gitkeep
!artifacts/charts/.gitkeep

# Packages / releases (store on Drive, not in repo)
*.tar.gz
*.tgz
force-trading-system-*.tar.gz

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*~

# Historical vault raw extracts (hashed in metadata; re-fetch via scripts)
force_learning/vault/raw/*.csv
force_learning/vault/raw/*.bin
force_learning/vault/raw/worldbank_rail_tkm.json
force_learning/vault/raw/oecd_itf_structure.json
!force_learning/vault/raw/probes.json
!force_learning/vault/raw/.gitkeep

